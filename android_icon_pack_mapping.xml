<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================
  ANDROID ICON PACK — APP MAPPING FILE
  ============================================================
  HOW TO USE THIS FILE:
  
  If you are building this as a proper Android icon pack app,
  include this file in your app's /res/xml/ folder and reference
  it in your AndroidManifest.xml.
  
  Each <item> maps one of your icons to an app's package name
  and activity. Users who install your icon pack app can then
  select it in supported launchers (Nova, Niagara, Lawnchair, etc.)
  and icons will be automatically applied.
  
  Replace "com.youriconpack" with your actual app package name.
  ============================================================
-->

